{
  "name": "menoslios-app",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-11-27",
  "images": { "binding": "IMAGES" },
  "alias": {
    "sharp": "./cloudflare/sharp.js",
    "yoga-layout/load": "./node_modules/workerd-yoga/dist/load.js",
    "@react-pdf/pdfkit": "./node_modules/@react-pdf/pdfkit/lib/pdfkit.js",
    "buffer": "./cloudflare/buffer.js",
  },
  "observability": {
    "logs": {
      "enabled": false,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true,
    },
    "issue_detection": {
      "enabled": true,
    },
  },
  "vars": {
    "AI_MODEL": "gpt-6-luna",
    "AI_PROVIDER": "openai",
    "APP_URL": "https://app.menoslios.com",
    "MENOSLIOS_CAL_BOOKING_URL": "https://cal.com/doscientos/puesta-en-marcha-abaco",
    "REDSYS_ENVIRONMENT": "test",
    "VITE_MENOSLIOS_ONBOARDING_BOOKING_URL": "https://cal.com/doscientos/puesta-en-marcha-abaco",
    "VITE_SUPABASE_PUBLISHABLE_KEY": "sb_publishable_ZdQk_x87ym6T-cpB-_eX0A_C_68clps",
    "VITE_SUPABASE_URL": "https://vqyicgarlksirpzrngut.supabase.co",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
