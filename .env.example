# Public browser configuration. RLS, never hidden client variables, protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
APP_URL=
REDSYS_ENVIRONMENT=
SEND_EMAIL_HOOK_SECRET=

SUPABASE_HOOK_SECRET=

RESEND_API_KEY=
RESEND_FROM=


SUPABASE_TOKEN=

# Server only: google (default) or openai. Never prefix these with VITE_.
AI_PROVIDER=google
AI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
OPENAI_API_KEY=

# Same HTTPS Cal.com meeting type URL on the Vite and Edge deployments.
