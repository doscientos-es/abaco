# Public browser configuration. RLS, never hidden client variables, protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
APP_URL=
REDSYS_ENVIRONMENT=
SEND_EMAIL_HOOK_SECRET=

SUPABASE_HOOK_SECRET=

RESEND_API_KEY=
RESEND_FROM=


SUPABASE_TOKEN=

# Server only: google (default) or openai. Never prefix these with VITE_.
AI_PROVIDER=google
AI_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=
OPENAI_API_KEY=

# Same HTTPS Cal.com meeting type URL on the Vite and Edge deployments.
VITE_MENOSLIOS_ONBOARDING_BOOKING_URL=
# Legacy Vite name remains supported until existing deployments are updated.
# VITE_ABACO_ONBOARDING_BOOKING_URL=
MENOSLIOS_CAL_BOOKING_URL=
MENOSLIOS_CAL_EVENT_TYPE_ID=
MENOSLIOS_CAL_WEBHOOK_SECRET=
# Edge functions also accept the legacy ABACO_ prefix during the transition.
